# The Detonation sandbox for Python packages: pip runs in here, so build
# hooks, setup.py and import-time code execute exactly as they would for a
# user. Same tools as the Node image (curl/wget so droppers work, strace for
# the runtime trace, ca-certificates so HTTPS verifies against the proxy's
# per-run CA), and an unprivileged user at uid 1000 like the Node image's.
# pinned by digest (refresh: docker buildx imagetools inspect python:3.12-slim --raw | sha256sum)
FROM python:3.12-slim@sha256:b18b261e1b4974b4f321451ad5251ded85abb22c2b8b262da527dda1d031ab30
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates curl wget strace \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --create-home --uid 1000 sandbox
